--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -280,6 +280,12 @@ class CommandProcessor {
 
   std::unique_ptr<rex::thread::Event> write_ptr_index_event_;
   std::atomic<uint32_t> write_ptr_index_;
+  // Ring (re-)initialization handshake: bumped by InitializeRingBuffer on the
+  // guest thread, consumed by the worker at loop top (which owns
+  // read_ptr_index_). A direct cross-thread read_ptr_index_ reset races the
+  // worker's own `read_ptr_index_ = ExecutePrimaryBuffer(...)` store.
+  std::atomic<uint32_t> ring_init_epoch_{0};
+  uint32_t ring_init_epoch_seen_ = 0;
 
   // Some titles submit writes beyond the emulated register file range in PM4
   // packets. Preserve these values so dependent packet logic can still observe
