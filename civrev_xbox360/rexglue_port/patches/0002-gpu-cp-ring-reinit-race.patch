index 60efcd3..382d1c3 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -285,6 +285,15 @@ void CommandProcessor::WorkerThreadMain() {
     }
 
     uint32_t write_ptr_index = write_ptr_index_.load();
+    // Apply a pending ring re-initialization (see InitializeRingBuffer).
+    // Loaded AFTER the write pointer: guest store order is epoch then WPTR,
+    // so observing the new WPTR guarantees observing the epoch bump.
+    uint32_t ring_init_epoch = ring_init_epoch_.load(std::memory_order_acquire);
+    if (ring_init_epoch != ring_init_epoch_seen_) {
+      ring_init_epoch_seen_ = ring_init_epoch;
+      read_ptr_index_ = 0;
+      continue;  // re-evaluate with a fresh write pointer under the new ring
+    }
     if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
