diff --git a/include/rex/input/mnk/mnk_keymap.h b/include/rex/input/mnk/mnk_keymap.h
new file mode 100644
index 0000000..0c0adca
--- /dev/null
+++ b/include/rex/input/mnk/mnk_keymap.h
@@ -0,0 +1,152 @@
+/**
+ * @file        rex/input/mnk/mnk_keymap.h
+ * @brief       TOML-configurable key/mouse -> Xbox 360 controller mapping.
+ *
+ * Loads a controls.toml describing which keyboard keys / mouse buttons map to
+ * each Xbox 360 controller control, plus mouse-motion options (which stick the
+ * mouse drives, sensitivity, Y inversion) and mouse-wheel bindings. When no
+ * file is configured (or it fails to parse), bindings fall back to the legacy
+ * per-control `keybind_*` cvars so existing behavior is preserved.
+ *
+ * @section mnk_keymap_schema Schema (all keys optional)
+ *
+ * @code{.toml}
+ * [options]
+ * enabled = true            # enable MnK emulation (same as --mnk_mode=true)
+ * user_index = 0            # controller slot 0-3
+ *
+ * [mouse]
+ * stick = "right"           # which stick mouse motion drives: right|left|none
+ * sensitivity = 1.0         # mouse sensitivity multiplier
+ * invert_y = false          # invert mouse Y
+ * wheel_up = "right_trigger"    # controller control pulsed by wheel up
+ * wheel_down = "left_trigger"   # controller control pulsed by wheel down
+ *
+ * [buttons]                 # value: key name string, or array of them
+ * a = ["Space", "LMB"]
+ * b = "Shift"
+ * start = ["Return", "Escape"]
+ * # ... (see kControlNames for the full list)
+ *
+ * [triggers]
+ * left = "RMB"
+ * right = "LMB"
+ *
+ * [sticks.left]             # digital stick emulation from keys
+ * up = "W"
+ * down = "S"
+ * left = "A"
+ * right = "D"
+ *
+ * [sticks.right]
+ * up = ""
+ * # ...
+ * @endcode
+ *
+ * Key names are the rex::ui::ParseVirtualKey() names ("A".."Z", "0".."9",
+ * "F1".."F24", "Space", "Return", "Escape", "Tab", "Shift", "Control", "Alt",
+ * "Up"/"Down"/"Left"/"Right", "LMB"/"RMB"/"MMB", numpad keys, ...).
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <rex/ui/virtual_key.h>
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rex::input::mnk {
+
+// Logical controller controls that can be bound to keys / mouse buttons.
+enum class Control : size_t {
+  kA,
+  kB,
+  kX,
+  kY,
+  kLeftShoulder,
+  kRightShoulder,
+  kLeftThumb,
+  kRightThumb,
+  kBack,
+  kStart,
+  kGuide,
+  kDpadUp,
+  kDpadDown,
+  kDpadLeft,
+  kDpadRight,
+  kLeftTrigger,
+  kRightTrigger,
+  kLStickUp,
+  kLStickDown,
+  kLStickLeft,
+  kLStickRight,
+  kRStickUp,
+  kRStickDown,
+  kRStickLeft,
+  kRStickRight,
+  kCount,
+};
+
+// Which stick mouse motion drives.
+enum class MouseStick : uint8_t {
+  kNone,
+  kLeft,
+  kRight,
+};
+
+class MnkKeymap {
+ public:
+  static constexpr size_t kControlCount = size_t(Control::kCount);
+
+  // TOML name for each control ([buttons]/[triggers]/[sticks.*] map onto these).
+  static const char* ControlName(Control control);
+  // Parse a controller-control name ("a", "start", "right_trigger", ...) as
+  // used by the [mouse] wheel_up / wheel_down values.
+  static Control ParseControlName(std::string_view name);  // kCount if invalid
+
+  MnkKeymap();
+
+  // Populate all bindings from the legacy keybind_* cvars (the defaults).
+  void LoadFromCvars();
+
+  // Load bindings from a TOML file, replacing the current ones entirely.
+  // On failure the previous bindings are kept and false is returned with a
+  // human-readable message in error_out.
+  bool LoadFromFile(const std::string& path, std::string* error_out);
+
+  const std::vector<rex::ui::VirtualKey>& bindings(Control control) const {
+    return bindings_[size_t(control)];
+  }
+
+  bool enabled_by_config() const { return enabled_by_config_; }
+  int32_t user_index() const { return user_index_; }
+  MouseStick mouse_stick() const { return mouse_stick_; }
+  double mouse_sensitivity() const { return mouse_sensitivity_; }
+  bool invert_mouse_y() const { return invert_mouse_y_; }
+  // Control pulsed by a wheel notch, or Control::kCount for none.
+  Control wheel_up_control() const { return wheel_up_control_; }
+  Control wheel_down_control() const { return wheel_down_control_; }
+
+  // One-line summary of the loaded bindings for logging.
+  std::string Describe() const;
+
+ private:
+  std::array<std::vector<rex::ui::VirtualKey>, kControlCount> bindings_;
+  bool enabled_by_config_ = false;
+  int32_t user_index_ = 0;
+  MouseStick mouse_stick_ = MouseStick::kRight;
+  double mouse_sensitivity_ = 1.0;
+  bool invert_mouse_y_ = false;
+  Control wheel_up_control_ = Control::kCount;
+  Control wheel_down_control_ = Control::kCount;
+};
+
+}  // namespace rex::input::mnk
