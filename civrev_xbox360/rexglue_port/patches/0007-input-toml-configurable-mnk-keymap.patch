+/**
+ * @file        input/mnk/mnk_keymap.cpp
+ * @brief       TOML-configurable key/mouse -> controller mapping.
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
