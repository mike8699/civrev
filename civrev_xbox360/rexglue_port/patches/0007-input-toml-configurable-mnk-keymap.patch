+/**
+ * @file        tests/unit/input/mnk_keymap_test.cpp
+ * @brief       Unit tests for the TOML keyboard/mouse controller mapping.
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/input/mnk/mnk_keymap.h>
+#include <rex/ui/virtual_key.h>
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace fs = std::filesystem;
+using rex::input::mnk::Control;
+using rex::input::mnk::MnkKeymap;
+using rex::input::mnk::MouseStick;
+using rex::ui::VirtualKey;
+
+static fs::path WriteToml(const std::string& name, const std::string& content) {
+  auto path = fs::temp_directory_path() / ("mnk_keymap_test_" + name);
+  std::ofstream(path) << content;
+  return path;
+}
+
+TEST_CASE("MnkKeymap parses buttons, triggers, sticks and options", "[mnk][keymap]") {
+  auto path = WriteToml("full.toml", R"([options]
+enabled = true
+user_index = 2
+
+[mouse]
+stick = "left"
+sensitivity = 2.5
+invert_y = true
+wheel_up = "right_trigger"
+wheel_down = "left_trigger"
+
+[buttons]
+a = ["Space", "LMB"]
+start = "Return"
+dpad_up = "Up"
+
+[triggers]
+left = "Q"
+right = "E"
+
+[sticks.left]
+up = "W"
+down = "S"
+)");
+
+  MnkKeymap keymap;
+  std::string error;
+  REQUIRE(keymap.LoadFromFile(path.string(), &error));
+  REQUIRE(error.empty());
+
+  CHECK(keymap.enabled_by_config());
+  CHECK(keymap.user_index() == 2);
+  CHECK(keymap.mouse_stick() == MouseStick::kLeft);
+  CHECK(keymap.mouse_sensitivity() == 2.5);
+  CHECK(keymap.invert_mouse_y());
+  CHECK(keymap.wheel_up_control() == Control::kRightTrigger);
+  CHECK(keymap.wheel_down_control() == Control::kLeftTrigger);
+
+  // A has two keys.
+  const auto& a = keymap.bindings(Control::kA);
+  REQUIRE(a.size() == 2);
+  CHECK(a[0] == VirtualKey::kSpace);
+  CHECK(a[1] == VirtualKey::kLButton);
+
+  CHECK(keymap.bindings(Control::kStart).size() == 1);
+  CHECK(keymap.bindings(Control::kStart)[0] == VirtualKey::kReturn);
+  CHECK(keymap.bindings(Control::kDpadUp)[0] == VirtualKey::kUp);
+  CHECK(keymap.bindings(Control::kLeftTrigger)[0] == VirtualKey::kQ);
+  CHECK(keymap.bindings(Control::kRightTrigger)[0] == VirtualKey::kE);
+  CHECK(keymap.bindings(Control::kLStickUp)[0] == VirtualKey::kW);
+  CHECK(keymap.bindings(Control::kLStickDown)[0] == VirtualKey::kS);
+
+  // Controls not mentioned in the TOML are unbound (bindings replace defaults).
+  CHECK(keymap.bindings(Control::kB).empty());
+
+  fs::remove(path);
+}
+
+TEST_CASE("MnkKeymap defaults are sensible when tables are omitted", "[mnk][keymap]") {
+  auto path = WriteToml("min.toml", "[buttons]\na = \"Space\"\n");
+  MnkKeymap keymap;
+  std::string error;
+  REQUIRE(keymap.LoadFromFile(path.string(), &error));
+  CHECK_FALSE(keymap.enabled_by_config());  // [options].enabled default false
+  CHECK(keymap.mouse_stick() == MouseStick::kRight);
+  CHECK(keymap.wheel_up_control() == Control::kCount);  // no wheel binding
+  CHECK(keymap.bindings(Control::kA)[0] == VirtualKey::kSpace);
+  fs::remove(path);
+}
+
+TEST_CASE("MnkKeymap rejects an unknown key name", "[mnk][keymap]") {
+  auto path = WriteToml("badkey.toml", "[buttons]\na = \"NotAKey\"\n");
+  MnkKeymap keymap;
+  std::string error;
+  CHECK_FALSE(keymap.LoadFromFile(path.string(), &error));
+  CHECK(error.find("NotAKey") != std::string::npos);
+  fs::remove(path);
+}
+
+TEST_CASE("MnkKeymap rejects an unknown control name", "[mnk][keymap]") {
+  auto path = WriteToml("badctl.toml", "[buttons]\nnope = \"Space\"\n");
+  MnkKeymap keymap;
+  std::string error;
+  CHECK_FALSE(keymap.LoadFromFile(path.string(), &error));
+  CHECK(error.find("nope") != std::string::npos);
+  fs::remove(path);
+}
+
+TEST_CASE("MnkKeymap rejects an invalid mouse stick", "[mnk][keymap]") {
+  auto path = WriteToml("badstick.toml", "[mouse]\nstick = \"middle\"\n");
+  MnkKeymap keymap;
+  std::string error;
+  CHECK_FALSE(keymap.LoadFromFile(path.string(), &error));
+  fs::remove(path);
+}
+
+TEST_CASE("MnkKeymap keeps previous bindings when a load fails", "[mnk][keymap]") {
+  auto good = WriteToml("good.toml", "[buttons]\nstart = \"Return\"\n");
+  MnkKeymap keymap;
+  std::string error;
+  REQUIRE(keymap.LoadFromFile(good.string(), &error));
+  REQUIRE(keymap.bindings(Control::kStart)[0] == VirtualKey::kReturn);
+
+  auto bad = WriteToml("bad2.toml", "[buttons]\nstart = \"Bogus\"\n");
+  CHECK_FALSE(keymap.LoadFromFile(bad.string(), &error));
+  // Unchanged after the failed load.
+  CHECK(keymap.bindings(Control::kStart)[0] == VirtualKey::kReturn);
+
+  fs::remove(good);
+  fs::remove(bad);
+}
+
+TEST_CASE("MnkKeymap ParseControlName round-trips control names", "[mnk][keymap]") {
+  for (size_t i = 0; i < MnkKeymap::kControlCount; ++i) {
+    Control control = Control(i);
+    CHECK(MnkKeymap::ParseControlName(MnkKeymap::ControlName(control)) == control);
+  }
+  CHECK(MnkKeymap::ParseControlName("definitely_not_a_control") == Control::kCount);
+}
