+ *              See LICENSE file in the project root for full license text.
+ */
+#include <rex/input/mnk/mnk_keymap.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/keybinds.h>
+
+#include <toml++/toml.h>
+
+#include <algorithm>
+#include <filesystem>
+#include <sstream>
+#include <utility>
+
+// Legacy per-control binds (defined in mnk_input_driver.cpp).
+REXCVAR_DECLARE(std::string, keybind_a);
+REXCVAR_DECLARE(std::string, keybind_b);
+REXCVAR_DECLARE(std::string, keybind_x);
+REXCVAR_DECLARE(std::string, keybind_y);
+REXCVAR_DECLARE(std::string, keybind_left_trigger);
+REXCVAR_DECLARE(std::string, keybind_right_trigger);
+REXCVAR_DECLARE(std::string, keybind_left_shoulder);
+REXCVAR_DECLARE(std::string, keybind_right_shoulder);
+REXCVAR_DECLARE(std::string, keybind_lstick_up);
+REXCVAR_DECLARE(std::string, keybind_lstick_down);
+REXCVAR_DECLARE(std::string, keybind_lstick_left);
+REXCVAR_DECLARE(std::string, keybind_lstick_right);
+REXCVAR_DECLARE(std::string, keybind_lstick_press);
+REXCVAR_DECLARE(std::string, keybind_rstick_press);
+REXCVAR_DECLARE(std::string, keybind_dpad_up);
+REXCVAR_DECLARE(std::string, keybind_dpad_down);
+REXCVAR_DECLARE(std::string, keybind_dpad_left);
+REXCVAR_DECLARE(std::string, keybind_dpad_right);
+REXCVAR_DECLARE(std::string, keybind_back);
+REXCVAR_DECLARE(std::string, keybind_start);
+REXCVAR_DECLARE(std::string, keybind_guide);
+REXCVAR_DECLARE(int32_t, mnk_user_index);
+REXCVAR_DECLARE(double, mnk_sensitivity);
+
+namespace rex::input::mnk {
+
+using rex::ui::ParseVirtualKey;
+using rex::ui::VirtualKey;
+
+namespace {
+
+constexpr const char* kControlNames[MnkKeymap::kControlCount] = {
+    "a",           "b",           "x",           "y",
+    "left_shoulder", "right_shoulder", "left_thumb", "right_thumb",
+    "back",        "start",       "guide",
+    "dpad_up",     "dpad_down",   "dpad_left",   "dpad_right",
+    "left_trigger", "right_trigger",
+    "lstick_up",   "lstick_down", "lstick_left", "lstick_right",
+    "rstick_up",   "rstick_down", "rstick_left", "rstick_right",
+};
+
+// Parse one key name; empty strings mean "unbound" and are skipped silently.
+bool AppendKeyName(std::vector<VirtualKey>& out, std::string_view name,
+                   const char* control_name, std::string* error_out) {
+  if (name.empty()) {
+    return true;
+  }
+  VirtualKey vk = ParseVirtualKey(name);
+  if (vk == VirtualKey::kNone) {
+    if (error_out) {
+      *error_out = "unknown key name \"" + std::string(name) + "\" bound to \"" +
+                   control_name + "\"";
+    }
+    return false;
+  }
+  out.push_back(vk);
+  return true;
+}
+
+// A binding value is either a string or an array of strings.
+bool ParseBindingValue(const toml::node* node, std::vector<VirtualKey>& out,
+                       const char* control_name, std::string* error_out) {
+  if (!node) {
+    return true;
+  }
+  if (const auto* str = node->as_string()) {
+    return AppendKeyName(out, str->get(), control_name, error_out);
+  }
+  if (const auto* arr = node->as_array()) {
+    for (const auto& element : *arr) {
+      const auto* element_str = element.as_string();
+      if (!element_str) {
+        if (error_out) {
+          *error_out = std::string("binding \"") + control_name +
+                       "\" array must contain only strings";
+        }
+        return false;
+      }
+      if (!AppendKeyName(out, element_str->get(), control_name, error_out)) {
+        return false;
+      }
+    }
+    return true;
+  }
+  if (error_out) {
+    *error_out = std::string("binding \"") + control_name +
+                 "\" must be a key name string or an array of them";
+  }
+  return false;
+}
+
+}  // namespace
+
+const char* MnkKeymap::ControlName(Control control) {
+  return kControlNames[size_t(control)];
+}
+
+Control MnkKeymap::ParseControlName(std::string_view name) {
+  for (size_t i = 0; i < kControlCount; ++i) {
+    if (name == kControlNames[i]) {
+      return Control(i);
+    }
+  }
+  return Control::kCount;
+}
+
+MnkKeymap::MnkKeymap() {
+  LoadFromCvars();
+}
+
+void MnkKeymap::LoadFromCvars() {
+  for (auto& binding : bindings_) {
+    binding.clear();
+  }
+  auto set = [&](Control control, const std::string& name) {
+    VirtualKey vk = ParseVirtualKey(name);
+    if (vk != VirtualKey::kNone) {
+      bindings_[size_t(control)].push_back(vk);
+    }
+  };
+  set(Control::kA, REXCVAR_GET(keybind_a));
+  set(Control::kB, REXCVAR_GET(keybind_b));
+  set(Control::kX, REXCVAR_GET(keybind_x));
+  set(Control::kY, REXCVAR_GET(keybind_y));
+  set(Control::kLeftShoulder, REXCVAR_GET(keybind_left_shoulder));
+  set(Control::kRightShoulder, REXCVAR_GET(keybind_right_shoulder));
+  set(Control::kLeftThumb, REXCVAR_GET(keybind_lstick_press));
+  set(Control::kRightThumb, REXCVAR_GET(keybind_rstick_press));
+  set(Control::kBack, REXCVAR_GET(keybind_back));
+  set(Control::kStart, REXCVAR_GET(keybind_start));
+  set(Control::kGuide, REXCVAR_GET(keybind_guide));
+  set(Control::kDpadUp, REXCVAR_GET(keybind_dpad_up));
+  set(Control::kDpadDown, REXCVAR_GET(keybind_dpad_down));
+  set(Control::kDpadLeft, REXCVAR_GET(keybind_dpad_left));
+  set(Control::kDpadRight, REXCVAR_GET(keybind_dpad_right));
+  set(Control::kLeftTrigger, REXCVAR_GET(keybind_left_trigger));
+  set(Control::kRightTrigger, REXCVAR_GET(keybind_right_trigger));
+  set(Control::kLStickUp, REXCVAR_GET(keybind_lstick_up));
+  set(Control::kLStickDown, REXCVAR_GET(keybind_lstick_down));
+  set(Control::kLStickLeft, REXCVAR_GET(keybind_lstick_left));
+  set(Control::kLStickRight, REXCVAR_GET(keybind_lstick_right));
+  enabled_by_config_ = false;
+  user_index_ = REXCVAR_GET(mnk_user_index);
+  mouse_stick_ = MouseStick::kRight;
+  mouse_sensitivity_ = REXCVAR_GET(mnk_sensitivity);
+  invert_mouse_y_ = false;
+  wheel_up_control_ = Control::kCount;
+  wheel_down_control_ = Control::kCount;
+}
+
+bool MnkKeymap::LoadFromFile(const std::string& path, std::string* error_out) {
+  toml::table root;
+  try {
+    root = toml::parse_file(path);
+  } catch (const toml::parse_error& err) {
+    if (error_out) {
+      std::ostringstream ss;
+      ss << err;
+      *error_out = ss.str();
+    }
+    return false;
+  }
+
+  MnkKeymap loaded;  // starts from cvar defaults; TOML bindings replace them
+  for (auto& binding : loaded.bindings_) {
+    binding.clear();
+  }
+
+  // [options]
+  if (const auto* options = root["options"].as_table()) {
+    loaded.enabled_by_config_ = (*options)["enabled"].value_or(false);
+    loaded.user_index_ =
+        std::clamp((*options)["user_index"].value_or(int64_t(0)), int64_t(0), int64_t(3));
+  }
+
+  // [mouse]
+  if (const auto* mouse = root["mouse"].as_table()) {
+    std::string stick = (*mouse)["stick"].value_or(std::string("right"));
+    if (stick == "right") {
+      loaded.mouse_stick_ = MouseStick::kRight;
+    } else if (stick == "left") {
+      loaded.mouse_stick_ = MouseStick::kLeft;
+    } else if (stick == "none") {
+      loaded.mouse_stick_ = MouseStick::kNone;
+    } else {
+      if (error_out) {
+        *error_out = "[mouse].stick must be \"right\", \"left\" or \"none\" (got \"" + stick +
+                     "\")";
+      }
+      return false;
+    }
+    loaded.mouse_sensitivity_ =
+        std::clamp((*mouse)["sensitivity"].value_or(1.0), 0.01, 100.0);
+    loaded.invert_mouse_y_ = (*mouse)["invert_y"].value_or(false);
+    for (const auto& [key, member] :
+         {std::pair{"wheel_up", &loaded.wheel_up_control_},
+          std::pair{"wheel_down", &loaded.wheel_down_control_}}) {
+      std::string value = (*mouse)[key].value_or(std::string());
+      if (!value.empty()) {
+        Control control = ParseControlName(value);
+        if (control == Control::kCount) {
+          if (error_out) {
+            *error_out = std::string("[mouse].") + key + " names an unknown control \"" + value +
+                         "\"";
+          }
+          return false;
+        }
+        *member = control;
+      }
+    }
+  } else {
+    loaded.mouse_sensitivity_ = REXCVAR_GET(mnk_sensitivity);
+  }
+
+  // [buttons] - face/system/dpad/shoulder/thumb buttons.
+  static constexpr Control kButtonControls[] = {
+      Control::kA,          Control::kB,          Control::kX,           Control::kY,
+      Control::kLeftShoulder, Control::kRightShoulder, Control::kLeftThumb, Control::kRightThumb,
+      Control::kBack,       Control::kStart,      Control::kGuide,
+      Control::kDpadUp,     Control::kDpadDown,   Control::kDpadLeft,    Control::kDpadRight,
+  };
+  if (const auto* buttons = root["buttons"].as_table()) {
+    for (Control control : kButtonControls) {
+      const char* name = ControlName(control);
+      if (!ParseBindingValue(buttons->get(name), loaded.bindings_[size_t(control)], name,
+                             error_out)) {
+        return false;
+      }
+    }
+    // Reject unknown button names so typos fail loudly instead of silently
+    // leaving a control unbound.
+    for (const auto& [key, value] : *buttons) {
+      Control control = ParseControlName(key.str());
+      bool known = false;
+      for (Control button : kButtonControls) {
+        if (control == button) {
+          known = true;
+          break;
+        }
+      }
+      if (!known) {
+        if (error_out) {
+          *error_out = "[buttons] has unknown control \"" + std::string(key.str()) + "\"";
+        }
+        return false;
+      }
+    }
+  }
+
+  // [triggers]
+  if (const auto* triggers = root["triggers"].as_table()) {
+    if (!ParseBindingValue(triggers->get("left"),
+                           loaded.bindings_[size_t(Control::kLeftTrigger)], "left_trigger",
+                           error_out) ||
+        !ParseBindingValue(triggers->get("right"),
+                           loaded.bindings_[size_t(Control::kRightTrigger)], "right_trigger",
+                           error_out)) {
+      return false;
+    }
+  }
+
+  // [sticks.left] / [sticks.right] - digital stick emulation.
+  struct StickControls {
+    const char* table_name;
+    Control up, down, left, right;
+  };
+  static constexpr StickControls kSticks[] = {
+      {"left", Control::kLStickUp, Control::kLStickDown, Control::kLStickLeft,
+       Control::kLStickRight},
+      {"right", Control::kRStickUp, Control::kRStickDown, Control::kRStickLeft,
+       Control::kRStickRight},
+  };
+  if (const auto* sticks = root["sticks"].as_table()) {
+    for (const StickControls& stick : kSticks) {
+      const auto* stick_table = (*sticks)[stick.table_name].as_table();
+      if (!stick_table) {
+        continue;
+      }
+      if (!ParseBindingValue(stick_table->get("up"), loaded.bindings_[size_t(stick.up)],
+                             ControlName(stick.up), error_out) ||
+          !ParseBindingValue(stick_table->get("down"), loaded.bindings_[size_t(stick.down)],
+                             ControlName(stick.down), error_out) ||
+          !ParseBindingValue(stick_table->get("left"), loaded.bindings_[size_t(stick.left)],
+                             ControlName(stick.left), error_out) ||
+          !ParseBindingValue(stick_table->get("right"), loaded.bindings_[size_t(stick.right)],
+                             ControlName(stick.right), error_out)) {
+        return false;
+      }
+    }
+  }
+
+  *this = std::move(loaded);
+  return true;
+}
+
+std::string MnkKeymap::Describe() const {
+  std::string result;
+  for (size_t i = 0; i < kControlCount; ++i) {
+    if (bindings_[i].empty()) {
+      continue;
+    }
+    if (!result.empty()) {
+      result += ", ";
+    }
+    result += kControlNames[i];
+    result += "=";
+    for (size_t j = 0; j < bindings_[i].size(); ++j) {
+      if (j) {
+        result += "+";
+      }
+      result += rex::ui::VirtualKeyToString(bindings_[i][j]);
+    }
+  }
+  return result;
+}
+
+}  // namespace rex::input::mnk
